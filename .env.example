# Root environment for Docker Compose. Copy to `.env` (or run `make init`, which also generates
# the secrets below). `.env` is git-ignored: never commit it and never paste real values here.
#
# Empty values marked REQUIRED have no default on purpose: Compose refuses to start without them.

# --- Application ------------------------------------------------------------------------------
APP_NAME="AI Social Studio"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8080
# REQUIRED. Laravel encryption key, format base64:<32 random bytes>. Generated by `make init`.
APP_KEY=
LOG_LEVEL=info

# --- Gateway (nginx) --------------------------------------------------------------------------
# Published on 127.0.0.1 only.
GATEWAY_PORT=8080
# Exact browser origins allowed to call the API with credentials (comma-separated, never "*").
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
# Comma-separated proxy IPs/CIDRs Laravel trusts for X-Forwarded-*. Leave empty unless the API sits
# behind a proxy you control, otherwise client IPs (and rate limits) can be spoofed.
TRUSTED_PROXIES=
SESSION_SECURE_COOKIE=false
# Public origin of the SPA (links in emails point here).
FRONTEND_URL=http://localhost:8080
# Hosts (with port) treated as the first-party SPA by Sanctum (cookie session + CSRF).
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:5173,127.0.0.1:8080
# Reject passwords found in known breaches (needs outbound HTTPS). Turn on in production.
AUTH_CHECK_BREACHED_PASSWORDS=false

# --- Mail (development: the bundled Mailpit catcher, inbox at http://localhost:8025) -----------
MAIL_FROM_ADDRESS=noreply@studio.test
MAILPIT_UI_PORT=8025

# --- MySQL ------------------------------------------------------------------------------------
MYSQL_DATABASE=ai_social_studio
MYSQL_USER=studio
# REQUIRED (generated by `make init`)
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Redis ------------------------------------------------------------------------------------
# REQUIRED (generated by `make init`)
REDIS_PASSWORD=

# --- AI service -------------------------------------------------------------------------------
AI_ENVIRONMENT=local
# REQUIRED. One secret per direction of Laravel <-> AI service signing (used from Phase 2).
AI_HMAC_SECRET_LARAVEL_TO_AI=
AI_HMAC_SECRET_AI_TO_LARAVEL=

# --- Frontend (PUBLIC values only: everything VITE_* is embedded in the browser bundle) --------
VITE_APP_NAME="AI Social Studio"

# --- Host file ownership for bind mounts (the Makefile sets these from `id -u` / `id -g`) -----
HOST_UID=1000
HOST_GID=1000
