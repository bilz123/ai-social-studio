{
  "components": {
    "schemas": {
      "CheckResult": {
        "properties": {
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "status": {
            "enum": [
              "ok",
              "fail"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "CheckResult",
        "type": "object"
      },
      "Grade": {
        "additionalProperties": false,
        "properties": {
          "contrast": {
            "default": 1.05,
            "maximum": 1.5,
            "minimum": 0.7,
            "title": "Contrast",
            "type": "number"
          },
          "saturation": {
            "default": 1.08,
            "maximum": 1.6,
            "minimum": 0.5,
            "title": "Saturation",
            "type": "number"
          },
          "vignette": {
            "default": true,
            "title": "Vignette",
            "type": "boolean"
          }
        },
        "title": "Grade",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JobError": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "JobError",
        "type": "object"
      },
      "JobStatus": {
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "canceled"
        ],
        "title": "JobStatus",
        "type": "string"
      },
      "LiveResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service",
          "version"
        ],
        "title": "LiveResponse",
        "type": "object"
      },
      "Logo": {
        "additionalProperties": false,
        "properties": {
          "corner": {
            "default": "top_right",
            "enum": [
              "top_left",
              "top_right",
              "bottom_left",
              "bottom_right"
            ],
            "title": "Corner",
            "type": "string"
          },
          "end_seconds": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Seconds"
          },
          "key": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._\\-/]{0,254}$",
            "title": "Key",
            "type": "string"
          },
          "margin_percent": {
            "default": 5,
            "maximum": 15.0,
            "minimum": 1.0,
            "title": "Margin Percent",
            "type": "number"
          },
          "opacity": {
            "default": 0.9,
            "maximum": 1.0,
            "minimum": 0.1,
            "title": "Opacity",
            "type": "number"
          },
          "start_seconds": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Seconds"
          },
          "width_percent": {
            "default": 14,
            "description": "Of the video width.",
            "maximum": 40.0,
            "minimum": 4.0,
            "title": "Width Percent",
            "type": "number"
          }
        },
        "required": [
          "key"
        ],
        "title": "Logo",
        "type": "object"
      },
      "Music": {
        "additionalProperties": false,
        "properties": {
          "fade_in_seconds": {
            "default": 0.5,
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Fade In Seconds",
            "type": "number"
          },
          "fade_out_seconds": {
            "default": 1.0,
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Fade Out Seconds",
            "type": "number"
          },
          "key": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._\\-/]{0,254}$",
            "title": "Key",
            "type": "string"
          },
          "loop": {
            "default": true,
            "title": "Loop",
            "type": "boolean"
          },
          "normalize": {
            "default": true,
            "description": "Even out loudness to -16 LUFS first.",
            "title": "Normalize",
            "type": "boolean"
          },
          "volume": {
            "default": 0.8,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Volume",
            "type": "number"
          }
        },
        "required": [
          "key"
        ],
        "title": "Music",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckResult"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "RenderOutput": {
        "properties": {
          "duration_seconds": {
            "title": "Duration Seconds",
            "type": "number"
          },
          "fps": {
            "title": "Fps",
            "type": "number"
          },
          "has_audio": {
            "title": "Has Audio",
            "type": "boolean"
          },
          "height": {
            "title": "Height",
            "type": "integer"
          },
          "output_key": {
            "title": "Output Key",
            "type": "string"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          },
          "width": {
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "output_key",
          "size_bytes",
          "duration_seconds",
          "width",
          "height",
          "fps",
          "has_audio"
        ],
        "title": "RenderOutput",
        "type": "object"
      },
      "RenderRequest": {
        "additionalProperties": false,
        "properties": {
          "aspect_ratio": {
            "default": "9:16",
            "enum": [
              "9:16",
              "1:1",
              "16:9"
            ],
            "title": "Aspect Ratio",
            "type": "string"
          },
          "duration_seconds": {
            "default": 10.0,
            "exclusiveMinimum": 1.0,
            "maximum": 60.0,
            "title": "Duration Seconds",
            "type": "number"
          },
          "fps": {
            "default": 30,
            "enum": [
              24,
              25,
              30,
              60
            ],
            "title": "Fps",
            "type": "integer"
          },
          "grade": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Grade"
              },
              {
                "type": "null"
              }
            ]
          },
          "idempotency_key": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9_-]{1,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          },
          "logo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Logo"
              },
              {
                "type": "null"
              }
            ]
          },
          "music": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Music"
              },
              {
                "type": "null"
              }
            ]
          },
          "output_key": {
            "description": "Storage key for the MP4 (must end in .mp4).",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._\\-/]{0,254}$",
            "title": "Output Key",
            "type": "string"
          },
          "overlays": {
            "items": {
              "$ref": "#/components/schemas/TextOverlay"
            },
            "maxItems": 4,
            "title": "Overlays",
            "type": "array"
          },
          "quality": {
            "default": "standard",
            "enum": [
              "draft",
              "standard",
              "high"
            ],
            "title": "Quality",
            "type": "string"
          },
          "resolution": {
            "default": "full",
            "description": "`preview` renders at half size for quick approval previews.",
            "enum": [
              "full",
              "preview"
            ],
            "title": "Resolution",
            "type": "string"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/Segment"
            },
            "maxItems": 6,
            "minItems": 1,
            "title": "Segments",
            "type": "array"
          },
          "transition": {
            "$ref": "#/components/schemas/TransitionSpec"
          }
        },
        "required": [
          "output_key",
          "segments"
        ],
        "title": "RenderRequest",
        "type": "object"
      },
      "RenderView": {
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobError"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "progress": {
            "title": "Progress",
            "type": "number"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RenderOutput"
              },
              {
                "type": "null"
              }
            ]
          },
          "stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "stage",
          "progress",
          "result",
          "error",
          "created_at",
          "updated_at"
        ],
        "title": "RenderView",
        "type": "object"
      },
      "Segment": {
        "additionalProperties": false,
        "properties": {
          "duration_seconds": {
            "exclusiveMinimum": 0.5,
            "maximum": 30.0,
            "title": "Duration Seconds",
            "type": "number"
          },
          "key": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._\\-/]{0,254}$",
            "title": "Key",
            "type": "string"
          },
          "kind": {
            "enum": [
              "clip",
              "image"
            ],
            "title": "Kind",
            "type": "string"
          },
          "zoom": {
            "$ref": "#/components/schemas/Zoom"
          }
        },
        "required": [
          "kind",
          "key",
          "duration_seconds"
        ],
        "title": "Segment",
        "type": "object"
      },
      "TextOverlay": {
        "additionalProperties": false,
        "properties": {
          "background": {
            "default": true,
            "title": "Background",
            "type": "boolean"
          },
          "color": {
            "default": "#ffffff",
            "title": "Color",
            "type": "string"
          },
          "end_seconds": {
            "exclusiveMinimum": 0.0,
            "title": "End Seconds",
            "type": "number"
          },
          "font_size": {
            "default": 64,
            "description": "Pixels at full 1080-wide size.",
            "maximum": 140.0,
            "minimum": 24.0,
            "title": "Font Size",
            "type": "integer"
          },
          "position": {
            "default": "bottom",
            "enum": [
              "top",
              "center",
              "bottom"
            ],
            "title": "Position",
            "type": "string"
          },
          "start_seconds": {
            "minimum": 0.0,
            "title": "Start Seconds",
            "type": "number"
          },
          "text": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "start_seconds",
          "end_seconds"
        ],
        "title": "TextOverlay",
        "type": "object"
      },
      "TransitionSpec": {
        "additionalProperties": false,
        "properties": {
          "duration_seconds": {
            "default": 1.0,
            "maximum": 2.0,
            "minimum": 0.1,
            "title": "Duration Seconds",
            "type": "number"
          },
          "type": {
            "default": "fade",
            "enum": [
              "fade",
              "fadeblack",
              "fadewhite",
              "dissolve",
              "wipeleft",
              "wiperight",
              "slideleft",
              "slideright",
              "smoothleft",
              "smoothright",
              "circleopen"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "title": "TransitionSpec",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Zoom": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "default": 0.12,
            "description": "0.12 = 12 % closer.",
            "maximum": 0.4,
            "minimum": 0.0,
            "title": "Amount",
            "type": "number"
          },
          "focus_x": {
            "default": 0.5,
            "description": "Where to zoom towards (0-1).",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Focus X",
            "type": "number"
          },
          "focus_y": {
            "default": 0.5,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Focus Y",
            "type": "number"
          },
          "style": {
            "default": "in",
            "enum": [
              "in",
              "out",
              "none"
            ],
            "title": "Style",
            "type": "string"
          }
        },
        "title": "Zoom",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "AI Social Studio - Video Renderer",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readyz",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/renders": {
      "post": {
        "operationId": "create_render_v1_renders_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenderView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Render",
        "tags": [
          "video-renderer"
        ]
      }
    },
    "/v1/renders/{render_id}": {
      "get": {
        "operationId": "get_render_v1_renders__render_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "render_id",
            "required": true,
            "schema": {
              "title": "Render Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenderView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Render",
        "tags": [
          "video-renderer"
        ]
      }
    },
    "/v1/renders/{render_id}/cancel": {
      "post": {
        "operationId": "cancel_render_v1_renders__render_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "render_id",
            "required": true,
            "schema": {
              "title": "Render Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenderView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel Render",
        "tags": [
          "video-renderer"
        ]
      }
    }
  }
}
