{
  "components": {
    "schemas": {
      "CheckResult": {
        "properties": {
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "status": {
            "enum": [
              "ok",
              "fail"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "CheckResult",
        "type": "object"
      },
      "ClipResult": {
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "cost_cents": {
            "title": "Cost Cents",
            "type": "number"
          },
          "duration_seconds": {
            "title": "Duration Seconds",
            "type": "number"
          },
          "height": {
            "title": "Height",
            "type": "integer"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "provider_job_id": {
            "title": "Provider Job Id",
            "type": "string"
          },
          "shot_id": {
            "title": "Shot Id",
            "type": "string"
          },
          "storage_key": {
            "title": "Storage Key",
            "type": "string"
          },
          "width": {
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "shot_id",
          "storage_key",
          "provider",
          "provider_job_id",
          "attempts",
          "duration_seconds",
          "width",
          "height",
          "cost_cents"
        ],
        "title": "ClipResult",
        "type": "object"
      },
      "GenerationRequest": {
        "additionalProperties": false,
        "properties": {
          "aspect_ratio": {
            "default": "9:16",
            "enum": [
              "9:16",
              "1:1",
              "16:9"
            ],
            "title": "Aspect Ratio",
            "type": "string"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9_-]{1,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          },
          "max_cost_cents": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Cost Cents"
          },
          "output_prefix": {
            "description": "Clips are stored as <prefix>/<shot_id>.mp4",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-/]{0,200}$",
            "title": "Output Prefix",
            "type": "string"
          },
          "provider": {
            "anyOf": [
              {
                "pattern": "^[a-z0-9_-]{1,32}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "seed": {
            "anyOf": [
              {
                "maximum": 2147483647.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "shots": {
            "items": {
              "$ref": "#/components/schemas/Shot"
            },
            "maxItems": 4,
            "minItems": 1,
            "title": "Shots",
            "type": "array"
          },
          "timeline": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TimelineSpec"
              },
              {
                "type": "null"
              }
            ],
            "description": "If given, the shots must add up to this length once crossfades are removed."
          }
        },
        "required": [
          "shots",
          "output_prefix"
        ],
        "title": "GenerationRequest",
        "type": "object"
      },
      "GenerationResult": {
        "properties": {
          "attempted_provider_jobs": {
            "description": "Every external job id created, including failed attempts.",
            "items": {
              "type": "string"
            },
            "title": "Attempted Provider Jobs",
            "type": "array"
          },
          "clips": {
            "items": {
              "$ref": "#/components/schemas/ClipResult"
            },
            "title": "Clips",
            "type": "array"
          },
          "total_cost_cents": {
            "title": "Total Cost Cents",
            "type": "number"
          }
        },
        "required": [
          "clips",
          "total_cost_cents",
          "attempted_provider_jobs"
        ],
        "title": "GenerationResult",
        "type": "object"
      },
      "GenerationView": {
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobError"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "progress": {
            "title": "Progress",
            "type": "number"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GenerationResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "shots": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ShotProgress"
            },
            "title": "Shots",
            "type": "object"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "stage",
          "progress",
          "shots",
          "result",
          "error",
          "created_at",
          "updated_at"
        ],
        "title": "GenerationView",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JobError": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "JobError",
        "type": "object"
      },
      "JobStatus": {
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "canceled"
        ],
        "title": "JobStatus",
        "type": "string"
      },
      "LiveResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service",
          "version"
        ],
        "title": "LiveResponse",
        "type": "object"
      },
      "ProviderInfo": {
        "properties": {
          "aspect_ratios": {
            "items": {
              "type": "string"
            },
            "title": "Aspect Ratios",
            "type": "array"
          },
          "cost_cents_per_second": {
            "title": "Cost Cents Per Second",
            "type": "number"
          },
          "max_seconds": {
            "title": "Max Seconds",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "enum": [
              "primary",
              "fallback",
              "available"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "name",
          "max_seconds",
          "aspect_ratios",
          "cost_cents_per_second",
          "role"
        ],
        "title": "ProviderInfo",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckResult"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "Shot": {
        "additionalProperties": false,
        "properties": {
          "duration_seconds": {
            "description": "Seconds used in the final video.",
            "exclusiveMinimum": 0.0,
            "maximum": 10.0,
            "title": "Duration Seconds",
            "type": "number"
          },
          "image_key": {
            "description": "Storage key of the source image.",
            "maxLength": 255,
            "title": "Image Key",
            "type": "string"
          },
          "negative_prompt": {
            "default": "",
            "maxLength": 800,
            "title": "Negative Prompt",
            "type": "string"
          },
          "prompt": {
            "maxLength": 1500,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "request_seconds": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 12.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Seconds to ask the provider for (>= duration).",
            "title": "Request Seconds"
          },
          "shot_id": {
            "pattern": "^[a-z0-9_-]{1,32}$",
            "title": "Shot Id",
            "type": "string"
          }
        },
        "required": [
          "shot_id",
          "image_key",
          "prompt",
          "duration_seconds"
        ],
        "title": "Shot",
        "type": "object"
      },
      "ShotProgress": {
        "properties": {
          "attempts": {
            "default": 0,
            "title": "Attempts",
            "type": "integer"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "provider_job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Job Id"
          },
          "state": {
            "default": "pending",
            "title": "State",
            "type": "string"
          }
        },
        "title": "ShotProgress",
        "type": "object"
      },
      "TimelineSpec": {
        "additionalProperties": false,
        "properties": {
          "crossfade_seconds": {
            "default": 1.0,
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Crossfade Seconds",
            "type": "number"
          },
          "total_duration_seconds": {
            "default": 10.0,
            "exclusiveMinimum": 0.0,
            "maximum": 60.0,
            "title": "Total Duration Seconds",
            "type": "number"
          }
        },
        "title": "TimelineSpec",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "AI Social Studio - Video Generator",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readyz",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/generations": {
      "post": {
        "operationId": "create_generation_v1_generations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Generation",
        "tags": [
          "video-generator"
        ]
      }
    },
    "/v1/generations/{generation_id}": {
      "get": {
        "operationId": "get_generation_v1_generations__generation_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "generation_id",
            "required": true,
            "schema": {
              "title": "Generation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Generation",
        "tags": [
          "video-generator"
        ]
      }
    },
    "/v1/generations/{generation_id}/cancel": {
      "post": {
        "operationId": "cancel_generation_v1_generations__generation_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "generation_id",
            "required": true,
            "schema": {
              "title": "Generation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel Generation",
        "tags": [
          "video-generator"
        ]
      }
    },
    "/v1/providers": {
      "get": {
        "operationId": "providers_v1_providers_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProviderInfo"
                  },
                  "title": "Response Providers V1 Providers Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Providers",
        "tags": [
          "video-generator"
        ]
      }
    }
  }
}
