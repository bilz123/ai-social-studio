# Laravel API configuration for running OUTSIDE Docker (`php artisan serve`).
# With Docker Compose, configuration comes from the repository-root .env instead
# (see /.env.example) and this file is not used.
#
# Never commit a real .env. Empty values below must be filled in locally.

APP_NAME="AI Social Studio"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=debug

# Comma-separated IPs/CIDRs of reverse proxies to trust (X-Forwarded-*). Empty = trust none.
TRUSTED_PROXIES=

# Origins allowed to call the API from a browser (explicit list, never "*").
# Needed only when the SPA runs on a different origin, e.g. `npm run dev` on :5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173
API_RATE_LIMIT_PER_MINUTE=120

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_social_studio
DB_USERNAME=
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=false

# Sanctum SPA session: hosts (with port) treated as the first-party web app.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000
FRONTEND_URL=http://localhost:5173
AUTH_CHECK_BREACHED_PASSWORDS=false
BCRYPT_ROUNDS=12

# Mail: "log" writes emails to the log. Point to SMTP (e.g. Mailpit on 1025) to see them.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@studio.test
HEALTH_CHECK_REDIS=true

# Internal AI service (FastAPI) and the two HMAC secrets (one per direction).
AI_SERVICE_URL=http://127.0.0.1:8000
AI_HMAC_SECRET_LARAVEL_TO_AI=
AI_HMAC_SECRET_AI_TO_LARAVEL=

# Social platform developer credentials (see docs/SOCIAL_PROVIDER_SETUP.md). Empty = platform shows
# "not set up"; nothing is simulated.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Product image uploads (Phase 5) -------------------------------------------------------------
# Disk for uploaded originals and thumbnails. Must be private. "local" = storage/app/private (dev);
# production: "s3" plus the AWS_* settings of an S3-compatible private bucket.
UPLOADS_DISK=local
# Largest single image in MB, and most images per project. Keep PHP's upload_max_filesize /
# post_max_size (infra/docker/api/uploads.ini) and nginx client_max_body_size above the file limit.
UPLOADS_MAX_MB=10
UPLOADS_MAX_IMAGES=10
