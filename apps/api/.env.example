# Laravel API configuration for running OUTSIDE Docker (`php artisan serve`).
# With Docker Compose, configuration comes from the repository-root .env instead
# (see /.env.example) and this file is not used.
#
# Never commit a real .env. Empty values below must be filled in locally.

APP_NAME="AI Social Studio"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=debug

# Comma-separated IPs/CIDRs of reverse proxies to trust (X-Forwarded-*). Empty = trust none.
TRUSTED_PROXIES=

# Origins allowed to call the API from a browser (explicit list, never "*").
# Needed only when the SPA runs on a different origin, e.g. `npm run dev` on :5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173
API_RATE_LIMIT_PER_MINUTE=120

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_social_studio
DB_USERNAME=
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=false
HEALTH_CHECK_REDIS=true

# Internal AI service (FastAPI) and the two HMAC secrets (one per direction).
AI_SERVICE_URL=http://127.0.0.1:8000
AI_HMAC_SECRET_LARAVEL_TO_AI=
AI_HMAC_SECRET_AI_TO_LARAVEL=
