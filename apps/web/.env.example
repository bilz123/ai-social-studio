# Browser-visible configuration. Every VITE_* value is bundled into the public JavaScript:
# NEVER put passwords, tokens, API keys or any other secret in this file.

# Base URL of the backend API as seen by the browser. A relative path keeps requests same-origin
# (served by the nginx gateway in Docker, or by the Vite dev proxy when running `npm run dev`).
VITE_API_BASE_URL=/api

# Public application name shown in the UI.
VITE_APP_NAME=AI Social Studio

# Path the SPA is served from ("/" in development, "/app/" when served behind the marketing site).
VITE_BASE_PATH=/

# Dev-only (not exposed to the browser): where `npm run dev` proxies /api to.
DEV_API_PROXY_TARGET=http://localhost:8080
