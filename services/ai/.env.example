# Settings for running the AI service outside Docker (e.g. `uvicorn app.main:app --reload`).
# Under Docker Compose these come from the root .env instead. Copy to `.env`; it is git-ignored.

AI_ENVIRONMENT=local
AI_LOG_LEVEL=info
# Redis with the password you chose; logical DB 2 is reserved for the AI queue.
REDIS_URL=redis://:CHANGE_ME@localhost:6379/2
# Required in staging/production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_HMAC_SECRET_LARAVEL_TO_AI=
AI_HMAC_SECRET_AI_TO_LARAVEL=
